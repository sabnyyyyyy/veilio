# ===================================================
# BlindBid Environment Configuration
# ===================================================

# Legacy V1 contract address (used only by the old BlindBid integration)
NEXT_PUBLIC_CONTRACT_ADDRESS=0x71C41234567890abcdef1234567890abcdef39A1
# Active legacy auction contract when a V4 deployment is not configured.
# Must point to a VEILIO V3 auction contract, never the V1 address above.
NEXT_PUBLIC_V3_CONTRACT_ADDRESS=
NEXT_PUBLIC_BNB_CHAIN_RPC=https://data-seed-prebsc-1-s1.bnbchain.org:8545

# Active auction contract. Set this to the deployed VeilNFTV4 address; when present,
# the app uses the V4 address and ABI for auction reads and writes.
NEXT_PUBLIC_V4_CONTRACT_ADDRESS=
REVIEWER_ADDRESS=
FEE_RECIPIENT_ADDRESS=
# Server/runtime secrets only. Never use NEXT_PUBLIC_ for private keys.
DEPLOYER_PRIVATE_KEY=
NFT_KEEPER_PRIVATE_KEY=

# IPFS Pinning Provider Credentials (Pinata)
# Option A: JWT token
PINATA_JWT=your_pinata_jwt_token_here

# Option B: API Key Pair
PINATA_API_KEY=your_pinata_api_key_here
PINATA_SECRET_API_KEY=your_pinata_secret_api_key_here

# Preferred Public IPFS Gateway
NEXT_PUBLIC_IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/

# Required for encrypted asset storage. Generate with `openssl rand -base64 32`.
# Keep this secret stable and backed up; losing it makes stored assets unrecoverable.
ASSET_KEY_ENCRYPTION_KEY=

# Production upload protections. Redis and ClamAV are required for uploads in production.
# Use an HTTPS Redis REST endpoint (for example an Upstash database).
ASSET_REDIS_REST_URL=
ASSET_REDIS_REST_TOKEN=
# ClamAV daemon reachable from the application network.
CLAMAV_HOST=
CLAMAV_PORT=3310
# Mount a durable private volume here for single-instance deployments.
VEILIO_ASSET_STORAGE_DIR=
